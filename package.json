{
	"name": "cmd-compress",
	"version": "0.4.1",
	"description": "Token compression mods for Command Code: terse replies (caveman), lean code (ponytail), condensed shell output (RTK) — one package, four mods.",
	"keywords": [
		"cmd-mod",
		"cmd-mod-hook",
		"cmd-mod-command",
		"commandcode",
		"tokens",
		"compression",
		"caveman",
		"ponytail",
		"rtk"
	],
	"license": "MIT",
	"type": "module",
	"repository": "https://github.com/malikshi/cmd-compress",
	"engines": {
		"node": ">=22.18.0"
	},
	"files": [
		"mods",
		"rules",
		"scripts",
		"types",
		"README.md",
		"LICENSE",
		"ATTRIBUTION.md"
	],
	"commandcode": {
		"mods": [
			"./mods/caveman.ts",
			"./mods/ponytail.ts",
			"./mods/rtk.ts",
			"./mods/compress.ts"
		]
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"verify": "npm run typecheck && node --test test/*.test.ts && node scripts/verify-mods.ts",
		"bench": "node bench/cli.ts output",
		"bench:prompt": "node bench/cli.ts prompt"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"typescript": "^5.6.3"
	}
}
